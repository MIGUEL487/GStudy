# Copie para .env, ao lado de package.json. Na Vercel, use Environment Variables.
SUPABASE_PROJECT_ID=axbuxmtshbflpiguoips
SUPABASE_URL=https://axbuxmtshbflpiguoips.supabase.co
SUPABASE_PUBLISHABLE_KEY=COLE_SUA_CHAVE_PUBLICA
VITE_SUPABASE_PROJECT_ID=axbuxmtshbflpiguoips
VITE_SUPABASE_URL=https://axbuxmtshbflpiguoips.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=COLE_A_MESMA_CHAVE_PUBLICA

# Gemini: uma única configuração para conversas, lousa e atividades.
# Chave somente no servidor. Nunca use prefixo VITE_.
BOARD_AI_API_KEY=
BOARD_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
BOARD_AI_MODEL=gemini-3.6-flash

# IA exclusiva do Sócrates (opcional). Pode ser gemini, deepseek ou omniroute.
# Para ter uma chave do Gemini exclusiva para o Sócrates, defina:
# SOCRATES_AI_PROVIDER=gemini
# SOCRATES_AI_API_KEY=sua_chave_do_google_ai_studio
# SOCRATES_AI_MODEL=gemini-3.6-flash
# Chave somente no servidor, sem prefixo VITE_.
SOCRATES_AI_PROVIDER=gemini
SOCRATES_AI_API_KEY=
SOCRATES_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
SOCRATES_AI_MODEL=gemini-3.6-flash

# Groq: alternativa quando o Gemini falha. Chave criada em console.groq.com/keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# OpenRouter: terceira opção gratuita, após falhas do Gemini e da Groq.
# Chave de openrouter.ai/settings/keys. Apenas modelos terminados em :free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free

# Busca oficial de vídeos, canais e capítulos para a biblioteca.
# Habilite YouTube Data API v3 no Google Cloud. Chave somente no servidor.
YOUTUBE_API_KEY=

# Notion: somente no servidor; NUNCA use prefixo VITE_ nessas chaves.
# Gere 32 bytes aleatórios em hexadecimal (64 caracteres) para criptografar os tokens.
NOTION_TOKEN_ENCRYPTION_KEY=
# Mesmas credenciais OAuth do Notion cadastradas no Supabase (renovação de acesso).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Recursos Sociais e Voz (true por padrão)
VITE_FEATURE_SOCIAL=true
VITE_FEATURE_VOICE=true
